---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LegalText from '../../../components/LegalText.astro';
import { breadcrumb } from '../../../schema';

const lang = 'he' as const;
---
<BaseLayout
  title="תנאי שימוש — Language Flipper"
  description="תנאי השימוש של Language Flipper — רישוי, גרסת הניסיון החינמית, רכישות והחזרים, ושימוש הוגן בכלי לתיקון גיבריש מקלדת עברית-אנגלית."
  lang={lang}
  schema={breadcrumb(
    { name: 'בית', url: encodeURI('https://languageflipper.com/he/בית/') },
    { name: 'תנאי שימוש', url: encodeURI('https://languageflipper.com/he/תנאי-שימוש/') },
  )}
>
  <Header lang={lang} />
  <main id="content">

    <!-- Hero banner: "תנאי שימוש" on textured purple bg -->
    <section class="legal-hero">
      <div class="container legal-hero-inner">
        <h1 class="legal-hero-h1">תנאי שימוש</h1>
      </div>
    </section>

    <!-- Legal body in Hebrew -->
    <LegalText heading="תנאי השירות של Language Flipper">
      <p><strong>עדכון אחרון: 15 במאי, 2026</strong></p>

      <p><strong>1. קבלת התנאים</strong> בעצם הגישה לאתר languageflipper.com או הורדה ושימוש באפליקציית שולחן העבודה של Language Flipper ("האפליקציה"), הנך מסכים להיות כפוף לתנאי שירות אלו. אם אינך מסכים עם חלק כלשהו מתנאים אלו, אנא אל תשתמש בשירותים שלנו.</p>

      <p><strong>2. רישיון ושימוש</strong> Language Flipper מסופק תחת מבנה של רישיון מסחרי.</p>

      <ul>
        <li><p><strong>תקופת ניסיון בחינם (Free Trial):</strong> האפליקציה מספקת מספר מוגבל של המרות ("flips") בחינם, כדי שתוכל לבדוק את הפונקציונליות על המערכת שלך.</p></li>
        <li><p><strong>רישיון בתשלום:</strong> רכישת רישיון מעניקה לך זכות אישית, בלתי בלעדית ובלתי ניתנת להעברה להשתמש באפליקציה.</p></li>
        <li><p><strong>הגבלות:</strong> אינך רשאי לבצע הנדסה לאחור (reverse-engineer), להפיץ מחדש, למכור מחדש, או לשתף באופן פומבי את מפתח הרישיון שלך. אנו שומרים לעצמנו את הזכות לשלול מפתחות רישיון שיתגלה כי נעשה בהם שימוש לרעה או שהודלפו לרשת.</p></li>
      </ul>

      <p><strong>3. רכישות והחזרים כספיים</strong> כל התשלומים מעובדים באופן מאובטח על ידי ספק הסליקה המורשה שלנו, Gumroad.</p>

      <ul>
        <li><p><strong>מדיניות החזרים (Refund Policy):</strong> אנו רוצים שתהיה מרוצה לחלוטין. אם האפליקציה אינה עובדת עם המערכת שלך, אנו מציעים התחייבות להחזר כספי תוך 14 ימים. פשוט השב לאימייל הקבלה שקיבלת מ-Gumroad או צור קשר עם כתובת התמיכה שלנו כדי לבקש החזר.</p></li>
      </ul>

      <p><strong>4. היעדר אחריות (Disclaimer of Warranties)</strong> האפליקציה מסופקת "כמות שהיא" (As Is) ו"על בסיס זמינות" (As Available). בעוד שאנו שואפים להבטיח ש-Language Flipper תעבוד בצורה חלקה בסביבות Mac ו-Windows, איננו יכולים להבטיח תאימות מוחלטת עם כל תוכנת צד-שלישי או עדכוני מערכת הפעלה עתידיים. איננו אחראים לכל אובדן נתונים, שגיאות הקלדה או תקלות מערכת הנובעות מהשימוש באפליקציה.</p>

      <p><strong>5. עדכונים לתנאים</strong> אנו עשויים לעדכן תנאים אלו מעת לעת כדי לשקף תכונות חדשות או דרישות חוקיות. המשך השימוש באפליקציה לאחר פרסום השינויים מהווה את הסכמתך לתנאים החדשים.</p>

      <p><strong>6. צור קשר</strong> לקבלת תמיכה, בקשות להחזר כספי או שאלות הנוגעות לתנאים אלו, אנא פנה אלינו בכתובת:</p>

      <ul>
        <li><p>דוא"ל: falafeltikunim@gmail.com</p></li>
      </ul>
    </LegalText>

  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* ── Legal hero ── */
  .legal-hero {
    position: relative;
    background-image: url('/assets/home-page-main.webp');
    background-size: cover;
    background-position: center top;
    min-height: 320px;
    display: flex;
    align-items: center;
  }
  .legal-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 0, 70, 0.45);
  }
  .legal-hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 80px;
    padding-bottom: 80px;
    text-align: right;
  }
  .legal-hero-h1 {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--lf-white);
    font-style: italic;
    text-align: right;
  }
</style>
