---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Hero from '../../../components/Hero.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import DownloadRow from '../../../components/DownloadRow.astro';
import HeadingLine from '../../../components/HeadingLine.astro';
import GetTheFeeling from '../../../components/GetTheFeeling.astro';
import Footer from '../../../components/Footer.astro';
import { softwareApplication } from '../../../schema';

const lang = 'he' as const;
---
<BaseLayout
    title="תיקון גיבריש והיפוך אנגלית לעברית במקלדת | Language Flipper"
    description="כתבתם גיבריש? Language Flipper הופך טקסט מאנגלית לעברית ומעברית לאנגלית בלחיצה אחת — תיקון מיידי של טעויות מקלדת. למק ולווינדוס, 40 פליפים חינם."
  lang={lang}
  schema={softwareApplication(lang)}
  preloadImage="/assets/language-Flipper-hero.webp"
>
  <Header lang={lang} />
  <main id="content">
    <Hero lang={lang} />
    <!-- Small purple gap between hero and how-it-works -->
    <div class="gradient-spacer"></div>
    <HowItWorks lang={lang} />
    <!-- Empty gradient spacer between how-it-works and download -->
    <div class="gradient-spacer-lg"></div>
    <DownloadRow lang={lang} />

    <!-- Hebrew "זה אשכרה ככה!" section — heading + paragraph + CTA (no solution cards) -->
    <section class="he-solution-section">
      <div class="he-solution-overlay" aria-hidden="true"></div>
      <div class="container he-solution-content">
        <h2 class="he-sol-h2">זה אשכרה ככה!</h2>
        <HeadingLine align="center" />
        <blockquote class="he-sol-body">
          <p><strong>האמת… כבר התרגלתם לזה בלי לשים לב- להציץ כל רגע במסך רק כדי לוודא שאתם בשפה הנכונה.</strong>&nbsp;</p>
          <p><strong>לי כבר אין את הבעיה הזאת.&nbsp;</strong></p>
          <p><strong>רוצים לראות איך זה עובד?&nbsp;&nbsp;</strong></p>
          <p><strong>בנינו לכם חדר נקי לניסויים!&nbsp;</strong><strong>לחצו על הקישור למטה ותעשו סיבוב על הפליפר שלנו.</strong></p>
        </blockquote>
        <a href="/he/תפליפו/" class="he-sol-cta">?רוצה לנסות</a>
      </div>
    </section>

    <!-- Search-intent section. Every phrasing here is one people actually type
         into Google for this problem, taken from Search Console rather than
         guessed. The gibberish line is not a gimmick: "dhcrha kgcrh," is a real
         recorded query - it is "גיבריש לעברית" typed on an English keyboard, by
         somebody looking for the fix while having the problem. -->
    <section class="he-intent">
      <div class="container he-intent-inner">
        <h2 class="he-intent-h2">מחפשים איך להפוך אנגלית לעברית?</h2>
        <HeadingLine align="center" />

        <p class="he-intent-lead">
          הגעתם למקום הנכון. <strong>Language Flipper</strong> עושה בדיוק את זה —
          <strong>היפוך טקסט מאנגלית לעברית</strong> ומעברית לאנגלית, בלחיצה אחת,
          בכל תוכנה שבה אתם כותבים.
        </p>

        <div class="he-intent-grid">
          <div class="he-intent-card">
            <h3>כתבתם גיבריש?</h3>
            <p>
              <em>akuo</em> במקום <em>שלום</em>, <em>vtkuo</em> במקום <em>הכול</em>.
              סמנו את הטקסט, הקישו <strong>CTRL + SHIFT + Y</strong>, והוא חוזר לעברית תקינה.
              גם בכיוון ההפוך — מעברית לאנגלית.
            </p>
          </div>
          <div class="he-intent-card">
            <h3>מקלדת אנגלית־עברית מתחלפת?</h3>
            <p>
              הכלי מזהה שהטקסט נכתב בשפה הלא נכונה ומחליף גם את פריסת המקלדת,
              כדי שההמשך כבר ייכתב נכון. בלי להקליד מחדש ובלי להעתיק לאתר חיצוני.
            </p>
          </div>
          <div class="he-intent-card">
            <h3>הפוך על הפוך — בלי התקנה מסובכת</h3>
            <p>
              תוכנה קטנה למק ולווינדוס שרצה ברקע. אין העתקה לאתר זר, אין חשבון,
              והטקסט שלכם לא עוזב את המחשב.
            </p>
          </div>
        </div>

        <p class="he-intent-gib">
          חיפשתם <code>dhcrha kgcrh,</code> וקיבלתם ג׳יבריש? זה בדיוק מה שכתוב שם —
          <strong>גיבריש לעברית</strong>. אנחנו מבינים אתכם.
        </p>
      </div>
    </section>

    <GetTheFeeling lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* ── search-intent section ── */
  .he-intent { background: var(--lf-bg-deep, #1D005B); padding: 64px 0 72px; text-align: center; }
  .he-intent-inner { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  .he-intent-h2 { font-size: clamp(26px, 4vw, 38px); line-height: 1.2; margin: 0 0 6px; color: #fff; }
  .he-intent-lead { font-size: clamp(16px, 2vw, 19px); line-height: 1.75; color: #E4DDF7; max-width: 760px; margin: 18px auto 34px; }
  .he-intent-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; text-align: start; }
  .he-intent-card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); border-radius: 14px; padding: 22px 20px; }
  .he-intent-card h3 { font-size: 19px; margin: 0 0 10px; color: #fff; }
  .he-intent-card p { font-size: 16px; line-height: 1.7; color: #D9D2EE; margin: 0; }
  .he-intent-card em { font-style: normal; background: rgba(255,255,255,.12); padding: 1px 6px; border-radius: 5px; }
  .he-intent-gib { margin: 34px auto 0; max-width: 720px; font-size: 16px; line-height: 1.75; color: #C9C0E6; }
  .he-intent-gib code { direction: ltr; unicode-bidi: isolate; background: rgba(255,255,255,.12); padding: 2px 8px; border-radius: 6px; font-size: 15px; }

  /* Elementor gradient spacer sections: 180deg transparent → #1D005B */
  .gradient-spacer {
    background: linear-gradient(180deg, #21252900 0%, #1D005B 100%);
    height: 20px;
    display: block;
  }
  .gradient-spacer-lg {
    background: linear-gradient(180deg, #21252900 0%, #1D005B 78%);
    height: 40px;
    display: block;
  }
  @media (max-width: 767px) {
    .gradient-spacer,
    .gradient-spacer-lg {
      height: 20px;
    }
  }

  /* ── Hebrew "זה אשכרה ככה!" section ── */
  .he-solution-section {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    text-align: center;
    overflow: hidden;
    background: var(--lf-bg-deep);
  }
  .he-solution-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(29, 0, 91, 0.60);
    z-index: 0;
  }
  /* Tilt shape at top matching the Elementor section */
  .he-solution-content {
    position: relative;
    z-index: 3;
    padding: 165px 1rem 145px;
    width: 100%;
    direction: rtl;
  }
  .he-sol-h2 {
    font-size: clamp(1.8rem, 6vw, 3.9rem);
    color: var(--lf-white);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .he-sol-body {
    margin: 0 auto 1.8rem;
    max-width: 760px;
    color: var(--lf-white);
    font-size: 1.42rem;
    line-height: 1.8;
    font-style: normal;
    border: none;
    padding: 0;
  }
  .he-sol-body p {
    margin-bottom: 0.2rem;
  }
  .he-sol-body strong {
    font-weight: 700;
  }
  .he-sol-cta {
    display: inline-block;
    background: var(--lf-magenta);
    color: var(--lf-white);
    padding: 0.55em 1.6em;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1.5rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .he-sol-cta:hover { opacity: 0.85; }

  @media (max-width: 767px) {
    .he-solution-section {
      min-height: 420px;
    }
    .he-solution-content {
      padding: 115px 1rem 95px;
    }
    .he-sol-body { font-size: 0.95rem; }
  }
</style>
