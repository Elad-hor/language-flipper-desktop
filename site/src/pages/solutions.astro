---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---
<BaseLayout
  title="Page not found - languageflipper.com"
  lang={lang}
>
  <Header lang={lang} />
  <main id="content">
    <section class="notfound-section">
      <!-- Wave SVG background -->
      <div class="nf-bg" aria-hidden="true">
        <img src="/assets/wave_404_x2.svg" alt="" class="nf-wave" />
      </div>

      <!-- BACK HOME circle button -->
      <a href="/" class="back-home" aria-label="Back Home">
        <span>BACK<br />HOME</span>
      </a>

      <div class="nf-message">
        <h1>We can't find the page you were looking for.</h1>
      </div>

      <div class="nf-digits" aria-hidden="true">
        <span class="digit">4</span>
        <span class="digit digit-zero">0</span>
        <span class="digit">4</span>
      </div>

      <!-- Decorative 3D shapes -->
      <div class="nf-shapes" aria-hidden="true">
        <img src="/assets/98_NFT_dash.svg" alt="" class="shape shape-dash" />
        <img src="/assets/98_NFT_piramida.svg" alt="" class="shape shape-pira" />
        <img src="/assets/98_NFT_wheel.svg" alt="" class="shape shape-wheel" />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .notfound-section {
    position: relative;
    background: #CC44FF;
    min-height: 980px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Wave SVG overlay at bottom */
  .nf-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .nf-wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* BACK HOME pill */
  .back-home {
    position: absolute;
    top: 2rem;
    right: 2rem;
    z-index: 10;
    background: var(--lf-gold);
    color: #5E00CC;
    border-radius: 50%;
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .back-home:hover { transform: scale(1.05); }

  /* "We can't find" heading */
  .nf-message {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 4rem 2rem 0;
    max-width: 560px;
    margin: 0 auto;
  }
  .nf-message h1 {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 600;
    color: var(--lf-white);
    line-height: 1.5;
  }

  /* Large 404 digits */
  .nf-digits {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    line-height: 0.85;
    margin-top: 0;
    width: 100%;
    padding: 0 2rem;
  }
  .digit {
    font-size: clamp(8rem, 20vw, 18rem);
    font-weight: 900;
    color: var(--lf-gold);
    letter-spacing: -0.02em;
    flex: 1;
    text-align: center;
  }
  .digit-zero {
    /* In ref the "0" aligns at top with the 4s */
    position: relative;
    top: 0;
  }

  /* Decorative 3D shapes at bottom */
  .nf-shapes {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 0;
    z-index: 4;
  }
  .shape {
    display: block;
    max-height: 240px;
    width: auto;
    object-fit: contain;
  }
  .shape-dash  { max-width: 300px; }
  .shape-pira  { max-width: 280px; position: relative; bottom: -10px; }
  .shape-wheel { max-width: 180px; margin-left: auto; }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .back-home {
      width: 72px;
      height: 72px;
      font-size: 0.7rem;
      top: 1rem;
      right: 1rem;
    }
    .digit { font-size: 6rem; }
    .shape { max-height: 140px; }
    .shape-dash  { max-width: 180px; }
    .shape-pira  { max-width: 160px; }
    .shape-wheel { max-width: 110px; }
  }
</style>
