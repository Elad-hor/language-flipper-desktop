---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DownloadRow from '../components/DownloadRow.astro';
import FlipText from '../components/FlipText.astro';
import HeadingLine from '../components/HeadingLine.astro';
import { breadcrumb } from '../schema';

const lang = 'en';
---
<BaseLayout
  title="About Language Flipper — The Hebrew-English Keyboard Fixer"
  description="Two bilingual developers got fed up typing gibberish and built Language Flipper. Here's the story behind the hotkey that fixes Hebrew-English typos instantly."
  lang={lang}
  schema={breadcrumb(
    { name: 'Home', url: 'https://languageflipper.com/' },
    { name: 'About Us', url: 'https://languageflipper.com/about-us/' },
  )}
>
  <Header lang={lang} />
  <main id="content">

    <!-- Hero: "Our story" typed heading + subtitle at bottom-left, solutions.webp bg -->
    <section class="about-hero">
      <div class="about-hero-content">
        <h1 class="about-hero-h1"><FlipText text="Our story" lang={lang} /></h1>
        <h2 class="about-hero-h2">
          We typed an entire brilliant paragraph while looking at the keyboard.<br />
          We looked up, and it was in the wrong language.<br />
          So we built this app to save our computers from being thrown out the window.
        </h2>
        <a href="/flip-it/" class="about-cta">Try it now</a>
      </div>
    </section>

    <!-- About Language Flipper: white bg, left text, right circuit deco -->
    <section class="about-body-section">
      <div class="about-body-grid container">
        <div class="about-text-col">
          <h2 class="about-h2">About Language Flipper</h2>
          <HeadingLine />
          <p>Language Flipper gives bilingual professionals the exact tool they need to stop wasting time retyping text and instantly fix frustrating keyboard layout mistakes.</p>
          <p>Our lightweight desktop application works seamlessly exactly where you work. Whether you are drafting emails in Outlook, managing clients in Salesforce, chatting in Slack, writing code in VS Code, or browsing in Chrome, etc., our hotkey rescues your mistyped text.</p>
          <p>Language Flipper actively prevents the ultimate momentum killer: the backspace key.</p>
          <p>That simple mechanism was implemented directly into your operating system, giving you the ability to keep your creative flow completely uninterrupted all day.</p>
          <p>Being bilingual typists who suffered through years of accidental gibberish, it has become our passion in life to make everyday typing entirely frustration-free.</p>
        </div>
        <!-- Right column: decorative circuit-board image (live site has bg-slideshow, we use img) -->
        <div class="about-deco-col" aria-hidden="true">
          <img src="/assets/Language-Flipper.webp" alt="" />
        </div>
      </div>
    </section>

    <!-- Download Now (reuse existing component) -->
    <DownloadRow lang={lang} />

    <!-- Talk to us: dark animated background section -->
    <section class="talk-section">
      <div class="talk-inner container">
        <h2 class="talk-h1">Talk to us</h2>
        <a href="/contact-us/" class="talk-cta">lets get in touch</a>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .about-hero {
    position: relative;
    background-image: url('/assets/about-language-flipper-hero.webp');
    background-size: cover;
    background-position: center center;
    min-height: 825px;
    display: flex;
    align-items: flex-start;   /* content at top */
    overflow: hidden;
  }
  /* dark overlay */
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(6, 0, 30, 0.48);
    z-index: 0;
  }
  /* Bottom fade into purple (same effect as the home hero) */
  .about-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background: linear-gradient(180deg, rgba(29,0,91,0) 0%, #1D005B 100%);
    z-index: 0;
    pointer-events: none;
  }
  .about-hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--lf-maxw);
    margin: 0 auto;
    padding: 80px 20px 60px;
    width: 100%;
    text-align: left;
  }
  .about-hero-h1 {
    /* bigger, with the same glow/graphic treatment as the home hero h1 */
    font-size: clamp(2.8rem, 5.9vw, 82px);
    font-weight: 600;
    letter-spacing: -2.5px;
    color: var(--lf-white);
    margin-bottom: 1.1rem;
    line-height: 1.1;
    text-shadow: 0 2px 28px rgba(0,0,0,0.65);
  }
  .about-hero-h2 {
    font-size: clamp(0.8rem, 1.4vw, 0.95rem);
    font-weight: 400;
    color: var(--lf-white);
    line-height: 1.8;
    margin-bottom: 1.75rem;
    max-width: 580px;
  }
  .about-cta {
    display: inline-block;
    background: var(--lf-magenta);
    color: var(--lf-white);
    padding: 10px 28px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.88rem;
    transition: opacity 0.2s;
  }
  .about-cta:hover { opacity: 0.85; }

  /* ─── About body (white bg, 2-col) ─── */
  .about-body-section {
    background: #fff;
    padding: 100px 0 160px;
  }
  .about-body-grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: 0;
    align-items: stretch;
  }
  .about-text-col {
    padding-right: 2rem;
  }
  .about-text-col p {
    color: #333;
    font-size: 1.12rem;
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }
  .about-h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    color: var(--lf-magenta);
    font-weight: 700;
    margin-bottom: 0.85rem;
    line-height: 1.2;
  }

  /* Right deco col: fill column height, show circuit circle (on left of image) */
  .about-deco-col {
    overflow: hidden;
    position: relative;
    min-height: 300px;
  }
  .about-deco-col img {
    /* Source image: 1920×1046 with tech circle on LEFT side.
       Fill the column and show the left portion where the circle lives. */
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    max-width: none;
    opacity: 0.95;
  }

  /* ─── Talk to us ─── */
  .talk-section {
    position: relative;
    background-image: url('/assets/our-partners.webp');
    background-size: cover;
    background-position: center center;
    min-height: 560px;
    display: flex;
    align-items: center;
  }
  /* Vibrant purple overlay — same treatment as the HP "Get the feeling" section */
  .talk-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(29,0,91,0.69);
  }
  /* No artificial bottom fade — the image's own vignette darkens into the footer,
     exactly like the HP "Get the feeling" section. */
  .talk-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-top: 96px;
    padding-bottom: 96px;
    width: 100%;
  }
  .talk-h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--lf-white);
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  .talk-cta {
    display: inline-block;
    background: var(--lf-magenta);
    color: var(--lf-white);
    padding: 12px 32px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }
  .talk-cta:hover { opacity: 0.85; }

  /* ─── Mobile ─── */
  @media (max-width: 767px) {
    .about-hero { min-height: 500px; }
    .about-body-grid {
      grid-template-columns: 1fr;
    }
    .about-deco-col { display: none; }
    .about-text-col { padding-right: 0; }
  }
</style>
