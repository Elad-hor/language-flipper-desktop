---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TryItWidget from '../components/TryItWidget.astro';
import DownloadRow from '../components/DownloadRow.astro';
import HeadingLine from '../components/HeadingLine.astro';
import { type Lang } from '../i18n/ui';
import { softwareApplication, breadcrumb } from '../schema';
import { GIBBERISH_PAIRS } from '../lib/gibberish';

const lang: Lang = 'en';

// English mirror of /he/גיבריש/. Same argument, different search terms: the
// English side of this market is crowded with layout converters, so the angle
// here is the Hebrew pair specifically rather than "keyboard layout" generally.
const title = "akuo = שלום | Hebrew Gibberish Converter, Free";
const description =
  "Paste the gibberish, get Hebrew back. akuo becomes שלום, dhcrha becomes גיבריש. " +
  "Fix text typed on the wrong keyboard layout — free, in your browser, no download.";
---
<BaseLayout
  title={title}
  description={description}
  lang={lang}
  schema={[
    softwareApplication(lang),
    breadcrumb(
      { name: 'Home', url: 'https://languageflipper.com/' },
      { name: 'Gibberish', url: 'https://languageflipper.com/gibberish/' },
    ),
  ]}
>
  <Header lang={lang} />

  <main id="content">

    <section class="gb-hero">
      <div class="container">
        <h1 class="gb-h1">
          <span class="gb-gib">akuo</span>
          <span class="gb-arrow" aria-hidden="true">→</span>
          <span class="gb-he">שלום</span>
        </h1>
        <p class="gb-sub">
          Typed something with the keyboard in the wrong language? Paste it below and
          get it back in Hebrew. No download, no sign-up, and it all happens in your browser.
        </p>
      </div>
    </section>

    <section class="gb-widget" id="demo">
      <div class="container">
        <TryItWidget />
      </div>
    </section>

    <section class="gb-table-section">
      <div class="container">
        <h2 class="gb-h2">Common words and their gibberish</h2>
        <HeadingLine align="center" />
        <p class="gb-table-intro">
          Each row is what happens when you type the Hebrew word while the keyboard is
          still set to English. If you searched for one of these, you are in the right place.
        </p>
        <div class="gb-scroll">
          <table class="gb-table">
            <thead>
              <tr><th scope="col">What you meant</th><th scope="col">What came out</th></tr>
            </thead>
            <tbody>
              {GIBBERISH_PAIRS.map((p) => (
                <tr>
                  <td class="gb-td-he" dir="rtl">{p.he}</td>
                  <td class="gb-td-gib">{p.gib}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="gb-why">
      <div class="container">
        <h2 class="gb-h2">Why does this happen?</h2>
        <HeadingLine align="center" />
        <p class="gb-why-p">
          The keyboard never changes which keys you press — only which letter each key
          produces. Type <span class="gb-inline-he" dir="rtl">שלום</span> with the layout
          still on English and you press exactly the same four keys, so out comes
          <span class="gb-inline-gib"> akuo</span>. Nothing is lost; the text was just
          written in the wrong alphabet, which means it converts back exactly.
        </p>
        <p class="gb-why-p">
          The tool above does that for text you paste. The app does it inside any
          program, on the text you already typed, with one keystroke — no copy and paste.
        </p>
      </div>
    </section>

    <DownloadRow lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .gb-hero { padding: 64px 0 34px; text-align: center; }
  .gb-h1 {
    display: flex; align-items: center; justify-content: center;
    gap: 16px; flex-wrap: wrap; margin: 0 0 18px;
    font-size: clamp(34px, 7vw, 62px); font-weight: 700; line-height: 1.1;
  }
  .gb-gib { font-family: ui-monospace, Menlo, Consolas, monospace; opacity: .65; }
  .gb-arrow { color: var(--lf-magenta); font-size: .8em; }
  .gb-he { color: var(--lf-gold); }
  .gb-sub { max-width: 56ch; margin: 0 auto; font-size: clamp(16px, 2.2vw, 19px); line-height: 1.6; }
  .gb-widget { padding: 8px 0 56px; }
  .gb-table-section, .gb-why { padding: 56px 0; }
  .gb-h2 { text-align: center; font-size: clamp(24px, 4vw, 34px); font-weight: 700; margin: 0 0 4px; }
  .gb-table-intro { max-width: 60ch; margin: 18px auto 26px; text-align: center; line-height: 1.6; }
  .gb-scroll { overflow-x: auto; max-width: 620px; margin: 0 auto; }
  .gb-table { width: 100%; border-collapse: collapse; }
  .gb-table th, .gb-table td { padding: 11px 18px; border-bottom: 1px solid rgba(255,255,255,.14); }
  .gb-table th { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; opacity: .7; text-align: left; }
  .gb-td-he { font-size: 18px; font-weight: 600; }
  .gb-td-gib { font-family: ui-monospace, Menlo, Consolas, monospace; opacity: .8; }
  .gb-why-p { max-width: 62ch; margin: 0 auto 16px; line-height: 1.7; text-align: center; }
  .gb-inline-he { color: var(--lf-gold); font-weight: 600; }
  .gb-inline-gib { font-family: ui-monospace, Menlo, Consolas, monospace; color: var(--lf-magenta); }
</style>
