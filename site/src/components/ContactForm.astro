---
// ContactForm.astro — contact form that posts to /contact.php
// On ?sent=1, shows a success confirmation instead of the form.
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
// Static build → ?sent=1 is detected client-side (see <script> below). PHP is
// told which page to return to so Hebrew submissions come back to the Hebrew page.
const redirectPath = lang === 'he' ? '/he/צור-קשר/' : '/contact-us/';

const labels = {
  firstName: lang === 'he' ? 'שם' : 'First Name',
  lastName: lang === 'he' ? 'משפחה' : 'Last Name',
  email: lang === 'he' ? 'דוא"ל' : 'Email',
  company: lang === 'he' ? 'חברה' : 'Company',
  message: lang === 'he' ? 'תוכן ההודעה' : 'Message',
  submit: lang === 'he' ? 'שגר' : 'SUBMIT',
  success: lang === 'he'
    ? 'ההודעה נשלחה בהצלחה! ניצור אתכם קשר בקרוב.'
    : "Your message was sent successfully! We'll be in touch soon.",
};
---

<div class="cf-success" hidden role="status" aria-live="polite">
  <div class="cf-success-icon" aria-hidden="true">✓</div>
  <p>{labels.success}</p>
</div>

<form class="cf-form" method="post" action="/contact.php">

  <!-- Honeypot: real users leave this empty; bots fill it -->
  <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="redirect" value={redirectPath} />

    <div class="cf-row">
      <div class="cf-field">
        <label for="cf-first-name" class="cf-label">{labels.firstName}</label>
        <input type="text" id="cf-first-name" name="first_name" class="cf-input" />
      </div>
      <div class="cf-field">
        <label for="cf-last-name" class="cf-label">{labels.lastName}</label>
        <input type="text" id="cf-last-name" name="last_name" class="cf-input" />
      </div>
    </div>

    <div class="cf-row">
      <div class="cf-field">
        <label for="cf-email" class="cf-label">{labels.email} <span class="cf-required" aria-label="required">*</span></label>
        <input type="email" id="cf-email" name="email" class="cf-input" required />
      </div>
      <div class="cf-field">
        <label for="cf-company" class="cf-label">{labels.company} <span class="cf-required" aria-label="required">*</span></label>
        <input type="text" id="cf-company" name="company" class="cf-input" required />
      </div>
    </div>

    <div class="cf-field cf-field--full">
      <label for="cf-message" class="cf-label">{labels.message}</label>
      <textarea id="cf-message" name="message" class="cf-textarea" rows="4"></textarea>
    </div>

    <div class="cf-submit-row">
      <button type="submit" class="cf-submit">{labels.submit}</button>
    </div>

  </form>

<script>
  // The site is statically built, so ?sent=1 (set by contact.php's redirect on
  // a successful send) must be handled in the browser: reveal the confirmation,
  // hide the form, then strip the query so a refresh doesn't re-show it.
  (function () {
    if (new URLSearchParams(window.location.search).get('sent') !== '1') return;
    const ok = document.querySelector('.cf-success');
    const form = document.querySelector('.cf-form');
    if (ok) ok.hidden = false;
    if (form) form.hidden = true;
    if (ok) ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
    history.replaceState(null, '', window.location.pathname);
  })();
</script>

<style>
  /* ── Success state ── */
  .cf-success {
    text-align: center;
    padding: 2.5rem 1rem;
    max-width: 640px;
    margin: 0 auto;
  }
  .cf-success-icon {
    width: 58px;
    height: 58px;
    margin: 0 auto 1.1rem;
    border-radius: 50%;
    background: var(--lf-magenta);
    color: #fff;
    font-size: 2.85rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(209, 71, 254, 0.35);
  }
  .cf-success p {
    font-size: 1.72rem;
    color: var(--lf-magenta);
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Form layout ── */
  .cf-form {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2rem;
    margin-bottom: 0;
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  .cf-field--full {
    grid-column: 1 / -1;
  }

  /* ── Labels ── */
  .cf-label {
    font-size: 1.23rem;
    font-weight: 500;
    color: #333;
    margin-bottom: 2px;
    letter-spacing: 0.01em;
  }

  .cf-required {
    color: #333;
  }

  /* ── Inputs: underline style matching reference ── */
  .cf-input,
  .cf-textarea {
    border: none;
    border-bottom: 1px solid #4B0FAC;
    outline: none;
    background: transparent;
    padding: 6px 0 4px;
    font-family: var(--lf-font);
    font-size: 1.32rem;
    color: #333;
    transition: border-color 0.2s;
    width: 100%;
  }

  .cf-input:focus,
  .cf-textarea:focus {
    border-bottom-color: var(--lf-magenta);
  }

  .cf-textarea {
    resize: vertical;
    min-height: 80px;
  }

  /* ── Submit button ── */
  .cf-submit-row {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .cf-submit {
    background: var(--lf-magenta);
    color: #fff;
    border: none;
    padding: 0.55em 1.6em;
    font-family: var(--lf-font);
    font-size: 1.5rem;
    line-height: 1.6;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    border-radius: 50px;
    transition: opacity 0.2s;
  }

  .cf-submit:hover {
    opacity: 0.88;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .cf-row {
      grid-template-columns: 1fr;
    }
  }
</style>
