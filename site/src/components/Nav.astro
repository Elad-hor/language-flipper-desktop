---
import { type Lang, t } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const aboutHref = lang === 'he' ? '/he/עלינו/' : '/about-us/';
const contactHref = lang === 'he' ? '/he/צור-קשר/' : '/contact-us/';
const flipHref = lang === 'he' ? '/he/תפליפו/' : '/flip-it/';
---
<nav class="nav">
  <button class="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
    <span class="bar bar-top" aria-hidden="true"></span>
    <span class="bar bar-mid" aria-hidden="true"></span>
    <span class="bar bar-bot" aria-hidden="true"></span>
  </button>
  <div class="nav-menu" id="nav-menu">
    <ul class="nav-links">
      <li><a href={aboutHref}>{t(lang, 'nav.about')}</a></li>
      <li><a href={contactHref}>{t(lang, 'nav.contact')}</a></li>
      <li><a href={flipHref}>{t(lang, 'nav.flip')}</a></li>
    </ul>
    <LanguageSwitcher lang={lang} />
  </div>
</nav>

<script>
  document.querySelectorAll('.nav').forEach((nav) => {
    const burger = nav.querySelector('.burger');
    const menu = nav.querySelector('.nav-menu');
    if (!burger || !menu) return;
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
    };
    burger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    // Close after tapping a link, and on Escape.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  });
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--lf-white);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.92;
    transition: opacity 0.2s;
  }
  .nav-links a:hover { opacity: 1; }
  /* Hebrew letters read smaller than uppercase Latin at the same px, so bump the
     RTL nav up to match the visual size of the English header. */
  :global(html[dir="rtl"]) .nav-links a { font-size: 1.35rem; }
  .burger {
    display: none;
    position: relative;
    width: 26px;
    height: 22px;
    background: none;
    border: none;
    color: var(--lf-white);
    cursor: pointer;
    padding: 0;
    order: 2; /* keep burger on the trailing side */
  }
  .burger .bar {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 50%;
    height: 2.5px;
    margin-top: -1.25px;
    background: currentColor;
    border-radius: 3px;
    transform-origin: center;
    /* spin the top/bottom bars around the middle, then settle into an X */
    transition: transform 0.45s cubic-bezier(0.68, -0.4, 0.27, 1.4), opacity 0.25s ease;
  }
  .burger .bar-top { transform: translateY(-7px) rotate(0deg); }
  .burger .bar-mid { transform: translateY(0) rotate(0deg); }
  .burger .bar-bot { transform: translateY(7px) rotate(0deg); }
  /* Open state: top & bottom circle around (405° / -405°) and cross into an X */
  .burger[aria-expanded='true'] .bar-top { transform: translateY(0) rotate(405deg); }
  .burger[aria-expanded='true'] .bar-mid { opacity: 0; transform: scaleX(0); }
  .burger[aria-expanded='true'] .bar-bot { transform: translateY(0) rotate(-405deg); }

  @media (max-width: 767px) {
    .burger { display: flex; }
    /* Full-width dropdown panel below the sticky header */
    .nav-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 1.4rem;
      background: rgba(29, 0, 91, 0.98);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 1.75rem 20px 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-menu.open { display: flex; }
    .nav-links {
      flex-direction: column;
      align-items: center;
      gap: 1.4rem;
    }
    .nav-links a { font-size: 1.1rem; }
  }
</style>
