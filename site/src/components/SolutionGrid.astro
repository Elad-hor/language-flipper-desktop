---
<section class="solution-section">
  <div class="container">
    <h2 class="sol-h2">{t(lang, 'solution.h2')}</h2>
    <div class="slash-decor" aria-hidden="true">
      <svg viewBox="0 0 640 512" xmlns="http://www.w3.org/2000/svg" width="28" height="28">
        <path fill="var(--lf-magenta)" d="M594.53 508.63L6.18 53.9c-6.97-5.42-8.23-15.47-2.81-22.45L23.01 6.18C28.43-.8 38.49-2.06 45.47 3.37L633.82 458.1c6.97 5.42 8.23 15.47 2.81 22.45l-19.64 25.27c-5.42 6.98-15.48 8.23-22.46 2.81z"/>
      </svg>
    </div>
    <p class="sol-sub">{t(lang, 'solution.subtitle')}</p>
    <div class="sol-grid">
      <SolutionCard
        title={t(lang, 'solution.card1_title')}
        body={t(lang, 'solution.card1_body')}
        icon={icons.lightning.d}
        viewBox={icons.lightning.viewBox}
      />
      <SolutionCard
        title={t(lang, 'solution.card2_title')}
        body={t(lang, 'solution.card2_body')}
        icon={icons.rescue.d}
        viewBox={icons.rescue.viewBox}
      />
      <SolutionCard
        title={t(lang, 'solution.card3_title')}
        body={t(lang, 'solution.card3_body')}
        icon={icons.secure.d}
        viewBox={icons.secure.viewBox}
      />
      <SolutionCard
        title={t(lang, 'solution.card4_title')}
        body={t(lang, 'solution.card4_body')}
        icon={icons.layout.d}
        viewBox={icons.layout.viewBox}
      />
    </div>
  </div>
</section>

<style>
  .solution-section {
    position: relative;
    min-height: 1280px;
    display: flex;
    align-items: center;
    overflow: hidden;
    text-align: center;
  }
  .solution-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/assets/how-it-works-1.webp');
    background-size: cover;
    background-position: center center;
    z-index: 0;
  }
  .solution-section::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Exact Elementor value: #1D005B at opacity 0.5 — uniform overlay */
    background-color: rgba(29,0,91,0.50);
    z-index: 1;
  }
  .solution-section .container {
    position: relative;
    z-index: 2;
    padding-top: 120px;
    padding-bottom: 120px;
    width: 100%;
  }
  .sol-h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--lf-white);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .slash-decor {
    display: flex;
    justify-content: center;
    margin-bottom: 0.8rem;
  }
  .sol-sub {
    color: var(--lf-text-muted);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .sol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 860px;
    margin: 0 auto;
    text-align: left;
  }

  @media (max-width: 767px) {
    .solution-section {
      min-height: 1884px;
    }
    .solution-section .container {
      padding-top: 80px;
      padding-bottom: 80px;
    }
    .sol-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
