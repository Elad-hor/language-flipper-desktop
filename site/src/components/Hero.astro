---
import Button from './Button.astro';
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const flipHref = lang === 'he' ? '/he/תפליפו/' : '/flip-it/';
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <h1 class="hero-h1">
      <span class="h1-line1">{t(lang, 'hero.h1')}<span class="accent">{t(lang, 'hero.h1_accent')}</span></span>
      {lang === 'en' && <span class="h1-flip accent" data-correct="Just Flip It.">Just Flip It.</span>}
    </h1>
    <p class="hero-sub">
      {t(lang, 'hero.subtitle_1')}<span class="accent">{t(lang, 'hero.subtitle_akuo')}</span>{t(lang, 'hero.subtitle_2')}<span class="accent">{t(lang, 'hero.subtitle_shalom')}</span>{t(lang, 'hero.subtitle_3')}
      <br />
      {t(lang, 'hero.subtitle_4')}<span class="accent">{t(lang, 'hero.subtitle_hotkey')}</span>{t(lang, 'hero.subtitle_5')}
    </p>
    <Button href={flipHref} label={t(lang, 'hero.cta')} />
  </div>
</section>

<script>
  // Animated hero headline: show "Just Flip It." first as wrong-keyboard-layout
  // gibberish, then flip it to the correct words — demonstrating what the app does.
  const flipEl = document.querySelector('.hero-h1 .h1-flip[data-correct]');
  if (flipEl) {
    const EN2HE = { q:'/', w:"'", e:'ק', r:'ר', t:'א', y:'ט', u:'ו', i:'ן', o:'ם',
      p:'פ', a:'ש', s:'ד', d:'ג', f:'כ', g:'ע', h:'י', j:'ח', k:'ל', l:'ך', z:'ז',
      x:'ס', c:'ב', v:'ה', b:'נ', n:'מ', m:'צ', ',':'ת', '.':'ץ', ';':'ף', '/':'.' };
    const correct = flipEl.getAttribute('data-correct') || '';
    const wrong = [...correct].map((ch) => EN2HE[ch.toLowerCase()] ?? ch).join('');
    let showingCorrect = false;
    flipEl.textContent = wrong; // start on the "mistyped" version
    setInterval(() => {
      flipEl.classList.add('flipping');
      setTimeout(() => {
        showingCorrect = !showingCorrect;
        flipEl.textContent = showingCorrect ? correct : wrong;
        flipEl.classList.remove('flipping');
      }, 320);
    }, 2400);
  }
</script>

<style>
  .hero {
    position: relative;
    /* Fill ~80% of the first screen; grow if content needs more room */
    min-height: 80vh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/language-Flipper-hero.webp');
    background-size: cover;
    background-position: top center;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Exact Elementor value: #1D005B at opacity 0.17 */
    background-color: rgba(29,0,91,0.17);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 280px;
    padding-bottom: 80px;
    max-width: 700px;
  }
  .hero-h1 {
    font-size: clamp(2.8rem, 5.9vw, 85px);
    font-weight: 600;
    color: var(--lf-white);
    line-height: 100px;
    letter-spacing: -3.5px;
    margin-bottom: 1rem;
    text-shadow: 0 2px 28px rgba(0,0,0,0.65);
  }
  .accent {
    color: var(--lf-magenta);
  }
  .h1-line1 { display: block; }
  /* Animated headline: starts as wrong-layout gibberish, flips to the real words */
  .h1-flip {
    display: inline-block;
    transform-origin: center bottom;
    transition: transform 0.32s ease, opacity 0.32s ease;
    will-change: transform, opacity;
    unicode-bidi: plaintext;
  }
  .h1-flip.flipping {
    transform: rotateX(90deg);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .h1-flip { transition: none; }
  }
  .hero-sub {
    color: var(--lf-white);
    font-size: 24px;
    font-weight: 500;
    line-height: 35px;
    letter-spacing: -0.9px;
    margin-bottom: 1.8rem;
    text-shadow: 0 1px 14px rgba(0,0,0,0.7);
    max-width: 560px;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 465px;
      align-items: flex-start;
    }
    /* Mobile: Elementor uses -401px 0px offset; with cover+390px viewport
       the image renders at ~832px wide, -401px shifts to show right portion */
    .hero-bg {
      background-position: 60% top;
    }
    .hero-overlay {
      background-color: rgba(29,0,91,0.25);
    }
    .hero-content {
      padding-top: 80px;
      padding-bottom: 60px;
    }
    .hero-h1 {
      font-size: 67px;
      line-height: 1.1;
      letter-spacing: 1.4px;
    }
    .hero-sub {
      font-size: 18px;
      line-height: 1.3em;
      letter-spacing: 0;
      max-width: 100%;
    }
  }
</style>
