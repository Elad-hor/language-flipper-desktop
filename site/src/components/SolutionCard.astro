---
interface Props {
  title: string;
  body: string;
  icon: string; // raw SVG path d attribute
  viewBox?: string;
}
const { title, body, icon, viewBox = '0 0 576 512' } = Astro.props;
---
<div class="sol-card">
  <div class="sol-icon" aria-hidden="true">
    <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d={icon} />
    </svg>
  </div>
  <h3 class="sol-title">{title}</h3>
  <p class="sol-body">{body}</p>
</div>

<style>
  .sol-card {
    background: var(--lf-white);
    color: #333;
    border-radius: var(--lf-radius);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sol-icon {
    color: var(--lf-magenta);
    width: 40px;
    height: 40px;
  }
  .sol-icon svg {
    width: 100%;
    height: 100%;
  }
  .sol-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--lf-magenta);
    margin: 0;
  }
  .sol-body {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #444;
    margin: 0;
  }
</style>
