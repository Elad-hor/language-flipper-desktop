---
// Shared "what to expect when installing" content.
// Rendered in TWO places from this one source: the collapsible under the
// download cards, and the per-OS modal that opens when a download is clicked.
// Both builds are currently unsigned (no codesign on Mac, codesign_identity=None
// on Windows), so every first-time user hits one of these OS warnings.
// When a certificate lands for one platform, delete that platform's block here
// and its i18n keys — the other platform is untouched.
import { type Lang, t } from '../i18n/ui';
import SmartScreenDemo from './SmartScreenDemo.astro';

interface Props {
  lang: Lang;
  /** Which platform block(s) to render. */
  os: 'mac' | 'win' | 'both';
}
const { lang, os } = Astro.props;
const showMac = os === 'mac' || os === 'both';
const showWin = os === 'win' || os === 'both';
---
<div class:list={['ih', os === 'both' && 'ih-both']}>
  {showMac && (
    <div class="ih-block">
      <h4 class="ih-h">
        <svg class="ih-logo" aria-hidden="true" viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg">
          <path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
        </svg>
        {t(lang, 'install.mac_h')}
      </h4>
      <ol class="ih-steps">
        <li>{t(lang, 'install.mac_s1')}</li>
        <li>{t(lang, 'install.mac_s2')}</li>
        <li>{t(lang, 'install.mac_s3')}</li>
        <li>{t(lang, 'install.mac_s4')}</li>
      </ol>
      <p class="ih-note">{t(lang, 'install.mac_note')}</p>
      <p class="ih-note">{t(lang, 'install.mac_perm')}</p>
    </div>
  )}

  {showWin && (
    <div class="ih-block">
      <h4 class="ih-h">
        <svg class="ih-logo" aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
          <path fill="currentColor" d="M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z"/>
        </svg>
        {t(lang, 'install.win_h')}
      </h4>
      <ol class="ih-steps">
        <li>{t(lang, 'install.win_s1')}</li>
        <li>{t(lang, 'install.win_s2')}</li>
        <li>{t(lang, 'install.win_s3')}</li>
        <li>{t(lang, 'install.win_s4')}</li>
      </ol>
      <SmartScreenDemo />
      <p class="ih-note">{t(lang, 'install.win_note')}</p>
    </div>
  )}
</div>

<style>
  .ih {
    text-align: start;
  }
  /* Side-by-side only when both platforms are shown (the collapsible). */
  .ih-both {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .ih-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--lf-gold);
  }
  .ih-logo {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .ih-steps {
    margin: 0;
    /* Logical padding so RTL flips the number gutter automatically. */
    padding-inline-start: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--lf-white);
  }
  .ih-steps li::marker {
    color: var(--lf-magenta);
    font-weight: 700;
  }
  .ih-note {
    margin: 0.9rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--lf-text-muted);
  }

  @media (max-width: 767px) {
    .ih-both {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .ih-h { font-size: 1.15rem; }
    .ih-steps { font-size: 0.95rem; }
    .ih-note { font-size: 0.85rem; }
  }
</style>
