---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section class="how-section">
  <div class="how-bg" aria-hidden="true"></div>
  <div class="how-overlay" aria-hidden="true"></div>
  <div class="container how-inner">
    <div class="how-grid">
      <div class="how-text-col">
        <h2 class="how-h2">{t(lang, 'how.h2')}</h2>
        <div class="how-line" aria-hidden="true"></div>
        <div class="how-body">
          <p>{t(lang, 'how.body_p1')}</p>
          <p>( <span class="accent">{t(lang, 'how.body_cmd')}</span>{t(lang, 'how.body_p2')}<span class="accent">{t(lang, 'how.body_ctrl')}</span>{t(lang, 'how.body_p3')}</p>
        </div>
      </div>
      <div class="how-right-col" aria-hidden="true"></div>
    </div>

    <!-- Video embed. To add your video, replace the placeholder <div> below with an
         iframe, e.g.:
         <iframe src="https://www.youtube.com/embed/VIDEO_ID" title="Language Flipper"
                 allow="accelerated-download; autoplay; encrypted-media; fullscreen"
                 allowfullscreen loading="lazy"></iframe> -->
    <div class="how-video">
      <div class="how-video-frame">
        <div class="how-video-placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="72" height="72">
            <circle cx="12" cy="12" r="11" fill="rgba(255,255,255,0.14)"></circle>
            <path d="M10 7.5l6.5 4.5L10 16.5z" fill="#fff"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- triangle / tilt divider at the end of the section (rotated 180deg) -->
  <div class="how-shape-bottom" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" preserveAspectRatio="none" style="transform:rotate(180deg)">
      <path fill="#1D005B" d="M0,6V0h1000v100L0,6z"></path>
    </svg>
  </div>
</section>

<script>
  // Slow reveal: the line rises up into place when the section scrolls into view.
  const line = document.querySelector('.how-section .how-line');
  if (line) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { line.classList.add('is-in'); io.disconnect(); }
      });
    }, { threshold: 0.6 });
    io.observe(line);
  }
</script>

<style>
  .how-section {
    position: relative;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }
  .how-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/how-it-works-1.webp');
    background-size: cover;
    background-position: center center;
    z-index: 0;
  }
  .how-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(29,0,91,0.53);
    z-index: 1;
  }
  .how-shape-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100px;
    z-index: 3;
    pointer-events: none;
  }
  .how-shape-bottom svg {
    width: 100%;
    height: 100%;
  }
  .how-inner {
    position: relative;
    z-index: 2;
    padding-top: 100px;
    padding-bottom: 110px;
    width: 100%;
  }
  .how-grid {
    display: grid;
    grid-template-columns: 50% 50%;
  }
  .how-h2 {
    font-size: 55px;
    font-weight: 700;
    line-height: 80px;
    letter-spacing: -2px;
    color: var(--lf-white);
    margin-bottom: 0.5rem;
  }
  /* straight line under the heading; hidden until it slowly rises into view */
  .how-line {
    width: 92px;
    height: 4px;
    background: var(--lf-magenta);
    border-radius: 2px;
    margin: 0.4rem 0 1.5rem;
    opacity: 0;
    transform: translateY(42px);
    transition: opacity 1.4s ease-out, transform 1.4s ease-out;
  }
  .how-line.is-in {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .how-line { transition: none; opacity: 1; transform: none; }
  }
  .how-body {
    color: var(--lf-white);
    font-size: 1.12rem;
    line-height: 1.8;
    max-width: 30rem;
  }
  .how-body p { margin: 0 0 1rem; }
  .how-body p:last-child { margin-bottom: 0; }
  .accent {
    color: var(--lf-magenta);
    font-weight: 600;
  }

  /* Video embed area (16:9), centered; the section ends after this. */
  .how-video {
    max-width: 880px;
    margin: 56px auto 0;
  }
  .how-video-frame {
    position: relative;
    padding-top: 56.25%;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.14);
    box-shadow: 0 10px 40px rgba(0,0,0,0.35);
  }
  .how-video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .how-video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .how-bg { background-position: center left; }
    .how-grid { grid-template-columns: 1fr; }
    .how-inner { padding-top: 80px; padding-bottom: 120px; }
    .how-h2 { font-size: 38px; line-height: 1.3em; letter-spacing: 0; }
    .how-body { font-size: 1rem; max-width: 100%; }
    .how-right-col { display: none; }
    .how-video { margin-top: 40px; }
  }
</style>
