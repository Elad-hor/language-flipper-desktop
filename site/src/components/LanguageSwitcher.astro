---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const targetLang = lang === 'en' ? 'he' : 'en';
const targetHref = lang === 'en' ? '/he/' : '/';
const label = t(lang, 'nav.lang_label');
---
<a href={targetHref} class="lang-switcher" aria-label={`Switch to ${targetLang}`}>
  <span class="slash-icon">
    <svg aria-hidden="true" viewBox="0 0 640 512" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
      <path fill="currentColor" d="M594.53 508.63L6.18 53.9c-6.97-5.42-8.23-15.47-2.81-22.45L23.01 6.18C28.43-.8 38.49-2.06 45.47 3.37L633.82 458.1c6.97 5.42 8.23 15.47 2.81 22.45l-19.64 25.27c-5.42 6.98-15.48 8.23-22.46 2.81z"/>
    </svg>
  </span>
  <span class="lang-label">{label}</span>
</a>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--lf-white);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  .lang-switcher:hover { opacity: 1; }
  .slash-icon {
    display: flex;
    align-items: center;
  }
</style>
